{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/agent-coverage-observations/v1",
  "title": "LureCoverage sensor acknowledgements v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "captured_at", "manifest_sha256", "observations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/agent-coverage-observations/v1"},
    "schema_version": {"const": 1},
    "captured_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observations": {
      "type": "array", "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["probe_id", "sensor_id", "observed_sequence", "copies", "lineage_contiguous", "delivery_delay_ms"],
        "properties": {
          "probe_id": {"$ref": "#/$defs/id"},
          "sensor_id": {"$ref": "#/$defs/id"},
          "observed_sequence": {"type": "integer", "minimum": 1, "maximum": 131072},
          "copies": {"type": "integer", "minimum": 1, "maximum": 1024},
          "lineage_contiguous": {"type": "boolean"},
          "delivery_delay_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}
        }
      }
    }
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"}}
}
