{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lurerevoke-campaign/v1",
  "title": "LureRevoke preregistered campaign composition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "campaign_id", "created_at", "system_id", "stream", "nodes", "events", "acceptance", "probe_schedule", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lurerevoke-campaign/v1"},
    "schema_version": {"const": 1},
    "campaign_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "system_id": {"$ref": "#/$defs/id"},
    "stream": {"type": "object", "additionalProperties": false, "required": ["transmitter_id", "receiver_audience_id", "stream_id", "profile", "authentication_boundary"], "properties": {"transmitter_id": {"$ref": "#/$defs/id"}, "receiver_audience_id": {"$ref": "#/$defs/id"}, "stream_id": {"$ref": "#/$defs/id"}, "profile": {"const": "openid-caep-1.0-final-metadata-projection"}, "authentication_boundary": {"const": "externally_verified_set_metadata"}}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["node_id", "mediation_point_id"], "properties": {"node_id": {"$ref": "#/$defs/id"}, "mediation_point_id": {"$ref": "#/$defs/id"}}}},
    "events": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/event"}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["maximum_convergence_ms", "maximum_deadline_miss_count", "maximum_post_deadline_allow_count", "maximum_collateral_block_count", "minimum_delivery_coverage_rate", "minimum_revoked_block_recall", "minimum_pre_event_allow_rate", "minimum_signal_disposition_accuracy"], "properties": {"maximum_convergence_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "maximum_deadline_miss_count": {"$ref": "#/$defs/count"}, "maximum_post_deadline_allow_count": {"$ref": "#/$defs/count"}, "maximum_collateral_block_count": {"$ref": "#/$defs/count"}, "minimum_delivery_coverage_rate": {"$ref": "#/$defs/rate"}, "minimum_revoked_block_recall": {"$ref": "#/$defs/rate"}, "minimum_pre_event_allow_rate": {"$ref": "#/$defs/rate"}, "minimum_signal_disposition_accuracy": {"$ref": "#/$defs/rate"}}},
    "probe_schedule": {"type": "object", "additionalProperties": false, "required": ["pre_event_offset_ms", "propagation_probe_offset_ms", "post_deadline_offset_ms", "include_unrelated_subject"], "properties": {"pre_event_offset_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "propagation_probe_offset_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "post_deadline_offset_ms": {"type": "integer", "minimum": 1, "maximum": 600000}, "include_unrelated_subject": {"const": true}}},
    "limitations": {"const": ["events_must_already_be_privacy_projected_and_digest_bound_no_sets_tokens_or_raw_subjects", "campaign_composition_generates_probes_but_does_not_deliver_signals_or_execute_access", "topology_and_acceptance_require_independent_review_before_collecting_observations", "all_probe_phases_cover_every_declared_node_but_not_undeclared_paths", "campaign_results_do_not_prove_complete_paths_authenticity_interoperability_or_compliance"]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "event": {"type": "object", "additionalProperties": false, "required": ["event_id", "sequence", "occurred_at_ms", "event_type", "subject", "attenuation_reason", "signal_sha256"], "properties": {"event_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000}, "occurred_at_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}, "event_type": {"enum": ["https://schemas.openid.net/secevent/caep/event-type/session-revoked", "https://schemas.openid.net/secevent/caep/event-type/credential-change", "https://schemas.openid.net/secevent/caep/event-type/device-compliance-change", "https://schemas.openid.net/secevent/caep/event-type/risk-level-change"]}, "subject": {"type": "object", "additionalProperties": false, "required": ["format", "id"], "properties": {"format": {"const": "opaque"}, "id": {"$ref": "#/$defs/id"}}}, "attenuation_reason": {"enum": ["session_revoked", "credential_revoked", "device_noncompliant", "risk_increased"]}, "signal_sha256": {"$ref": "#/$defs/digest"}}}
  }
}
