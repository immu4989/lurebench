{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/agent-coverage-canaries/v1",
  "title": "LureCoverage payload-free canary set v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "created_at", "manifest_sha256", "replicates_per_route", "probes"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/agent-coverage-canaries/v1"},
    "schema_version": {"const": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "replicates_per_route": {"type": "integer", "minimum": 1, "maximum": 32},
    "probes": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["probe_id", "emitted_sequence", "route_id", "action", "resource_class", "enforcement_point_id", "expected_sensor_id", "executes_action"],
        "properties": {
          "probe_id": {"$ref": "#/$defs/id"},
          "emitted_sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
          "route_id": {"$ref": "#/$defs/id"},
          "action": {"$ref": "#/$defs/id"},
          "resource_class": {"$ref": "#/$defs/id"},
          "enforcement_point_id": {"$ref": "#/$defs/id"},
          "expected_sensor_id": {"$ref": "#/$defs/id"},
          "executes_action": {"const": false}
        }
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
