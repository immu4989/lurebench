{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lurerevoke-plan-v1",
  "title": "LureRevoke continuous-access convergence plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "plan_id", "created_at", "system_id", "stream", "nodes", "events", "probes", "acceptance", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lurerevoke-plan-v1"},
    "schema_version": {"const": 1},
    "plan_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "system_id": {"$ref": "#/$defs/id"},
    "stream": {
      "type": "object", "additionalProperties": false,
      "required": ["transmitter_id", "receiver_audience_id", "stream_id", "profile", "authentication_boundary"],
      "properties": {
        "transmitter_id": {"$ref": "#/$defs/id"},
        "receiver_audience_id": {"$ref": "#/$defs/id"},
        "stream_id": {"$ref": "#/$defs/id"},
        "profile": {"const": "openid-caep-1.0-final-metadata-projection"},
        "authentication_boundary": {"const": "externally_verified_set_metadata"}
      }
    },
    "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/node"}},
    "events": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/event"}},
    "probes": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/probe"}},
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["maximum_convergence_ms", "maximum_deadline_miss_count", "maximum_post_deadline_allow_count", "maximum_collateral_block_count", "minimum_delivery_coverage_rate", "minimum_revoked_block_recall", "minimum_pre_event_allow_rate", "minimum_signal_disposition_accuracy"],
      "properties": {
        "maximum_convergence_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
        "maximum_deadline_miss_count": {"$ref": "#/$defs/count"},
        "maximum_post_deadline_allow_count": {"$ref": "#/$defs/count"},
        "maximum_collateral_block_count": {"$ref": "#/$defs/count"},
        "minimum_delivery_coverage_rate": {"$ref": "#/$defs/rate"},
        "minimum_revoked_block_recall": {"$ref": "#/$defs/rate"},
        "minimum_pre_event_allow_rate": {"$ref": "#/$defs/rate"},
        "minimum_signal_disposition_accuracy": {"$ref": "#/$defs/rate"}
      }
    },
    "limitations": {"const": ["synthetic_relative_timing_and_opaque_identifiers_only_no_tokens_credentials_or_payloads", "caep_event_types_are_metadata_projections_not_security_event_tokens_or_wire_conformance", "signal_authentication_transport_delivery_and_clock_sync_require_external_controls", "finite_scenarios_do_not_prove_complete_revocation_or_zero_trust_compliance"]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 4096},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["node_id", "mediation_point_id"],
      "properties": {"node_id": {"$ref": "#/$defs/id"}, "mediation_point_id": {"$ref": "#/$defs/id"}}
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "id"],
      "properties": {"format": {"const": "opaque"}, "id": {"$ref": "#/$defs/id"}}
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "sequence", "occurred_at_ms", "event_type", "subject", "attenuation_reason", "signal_sha256"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "occurred_at_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "event_type": {"enum": ["https://schemas.openid.net/secevent/caep/event-type/session-revoked", "https://schemas.openid.net/secevent/caep/event-type/credential-change", "https://schemas.openid.net/secevent/caep/event-type/device-compliance-change", "https://schemas.openid.net/secevent/caep/event-type/risk-level-change"]},
        "subject": {"$ref": "#/$defs/subject"},
        "attenuation_reason": {"enum": ["credential_revoked", "device_noncompliant", "risk_increased", "session_revoked"]},
        "signal_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "probe": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "event_id", "node_id", "attempted_at_ms", "subject_id"],
      "properties": {"probe_id": {"$ref": "#/$defs/id"}, "event_id": {"$ref": "#/$defs/id"}, "node_id": {"$ref": "#/$defs/id"}, "attempted_at_ms": {"type": "integer", "minimum": 0, "maximum": 86400000}, "subject_id": {"$ref": "#/$defs/id"}}
    }
  }
}
