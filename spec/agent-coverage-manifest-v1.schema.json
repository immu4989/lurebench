{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/agent-coverage-manifest/v1",
  "title": "LureCoverage route manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "manifest_id", "manifest_version", "system_id", "routes", "acceptance", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/agent-coverage-manifest/v1"},
    "schema_version": {"const": 1},
    "manifest_id": {"$ref": "#/$defs/id"},
    "manifest_version": {"$ref": "#/$defs/id"},
    "system_id": {"$ref": "#/$defs/id"},
    "routes": {
      "type": "array", "minItems": 1, "maxItems": 256,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["route_id", "action", "resource_class", "enforcement_point_id", "sensor_id", "required", "max_delivery_delay_ms"],
        "properties": {
          "route_id": {"$ref": "#/$defs/id"},
          "action": {"$ref": "#/$defs/action"},
          "resource_class": {"$ref": "#/$defs/resource"},
          "enforcement_point_id": {"$ref": "#/$defs/id"},
          "sensor_id": {"$ref": "#/$defs/id"},
          "required": {"type": "boolean"},
          "max_delivery_delay_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
        }
      }
    },
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "action": {"enum": ["approved_tool_call", "control_plane_change", "credential_read", "credential_use", "data_stage", "evaluator_probe", "network_request", "package_read", "package_write", "peer_signal_read", "peer_signal_write", "privilege_change", "run_restart", "run_stop", "safe_stop", "task_blocked", "task_impossible"]},
    "resource": {"enum": ["approved_package_mirror", "approved_peer_channel", "cluster_control_plane", "credential_store", "evaluation_control", "external_data_store", "host_runtime", "local_workspace", "none", "public_network", "shared_service", "third_party_service", "unauthorized_peer_channel"]},
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_route_coverage", "minimum_probe_delivery_rate", "maximum_duplicate_rate", "maximum_out_of_order_rate", "minimum_lineage_continuity", "maximum_delivery_delay_ms"],
      "properties": {
        "minimum_route_coverage": {"$ref": "#/$defs/rate"},
        "minimum_probe_delivery_rate": {"$ref": "#/$defs/rate"},
        "maximum_duplicate_rate": {"$ref": "#/$defs/rate"},
        "maximum_out_of_order_rate": {"$ref": "#/$defs/rate"},
        "minimum_lineage_continuity": {"$ref": "#/$defs/rate"},
        "maximum_delivery_delay_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
      }
    },
    "limitations": {
      "const": [
        "canaries_are_typed_metadata_and_do_not_execute_agent_actions",
        "coverage_applies_only_to_declared_routes_sensors_and_capture_window",
        "sensor_acknowledgements_are_operator_supplied_and_must_be_independently_trusted",
        "passing_does_not_prove_semantic_correctness_of_non_canary_production_events",
        "results_are_measurement_evidence_not_containment_compliance_or_authorization"
      ]
    }
  }
}
