{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lureidentity-plan-v1",
  "title": "LureIdentity lifecycle-closure plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "plan_id", "created_at", "system_id", "directory", "principals", "authority_edges", "grants", "nodes", "events", "probes", "acceptance", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lureidentity-plan-v1"},
    "schema_version": {"const": 1},
    "plan_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "system_id": {"$ref": "#/$defs/id"},
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer_id", "tenant_id", "profile", "authentication_boundary"],
      "properties": {
        "issuer_id": {"$ref": "#/$defs/id"},
        "tenant_id": {"$ref": "#/$defs/id"},
        "profile": {"const": "ietf-scim-rfc7643-lifecycle-metadata-projection"},
        "authentication_boundary": {"const": "externally_authenticated_and_authorized"}
      }
    },
    "principals": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/principal"}},
    "authority_edges": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/edge"}},
    "grants": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/grant"}},
    "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/node"}},
    "events": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/event"}},
    "probes": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"$ref": "#/$defs/probe"}},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "limitations": {"const": ["synthetic_identity_and_authorization_metadata_only_no_credentials_tokens_or_payloads", "scim_fields_are_a_lifecycle_projection_not_scim_http_patch_or_endpoint_conformance", "event_authentication_delivery_clock_quality_and_complete_mediation_are_external_controls", "finite_graph_closure_results_do_not_prove_zero_trust_compliance_or_system_containment"]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "count": {"type": "integer", "minimum": 0, "maximum": 8192},
    "nullable_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_id", "kind", "active", "spiffe_id"],
      "properties": {
        "principal_id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["agent", "group", "human", "workload"]},
        "active": {"type": "boolean"},
        "spiffe_id": {"oneOf": [{"type": "string", "minLength": 12, "maxLength": 2048, "pattern": "^spiffe://[a-z0-9._-]{1,255}(?:/(?!\\.{1,2}(?:/|$))[A-Za-z0-9._-]+)+$"}, {"type": "null"}]}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["edge_id", "source_id", "target_id", "relationship"],
      "properties": {
        "edge_id": {"$ref": "#/$defs/id"},
        "source_id": {"$ref": "#/$defs/id"},
        "target_id": {"$ref": "#/$defs/id"},
        "relationship": {"enum": ["delegates_to", "member_of", "runs_as"]}
      }
    },
    "grant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grant_id", "principal_id", "resource_id", "action"],
      "properties": {
        "grant_id": {"$ref": "#/$defs/id"},
        "principal_id": {"$ref": "#/$defs/id"},
        "resource_id": {"$ref": "#/$defs/id"},
        "action": {"enum": ["administer", "credential_use", "invoke", "read", "write"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "enforcement_point_id"],
      "properties": {"node_id": {"$ref": "#/$defs/id"}, "enforcement_point_id": {"$ref": "#/$defs/id"}}
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "sequence", "occurred_at_ms", "event_type", "target_principal_id", "target_edge_id", "required_cut_actor_ids", "required_preserve_actor_ids", "source_event_sha256", "event_sha256"],
      "properties": {
        "event_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "occurred_at_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "event_type": {"enum": ["delegation_revoked", "scim_group_membership_removed", "scim_user_deactivated", "workload_retired"]},
        "target_principal_id": {"$ref": "#/$defs/nullable_id"},
        "target_edge_id": {"$ref": "#/$defs/nullable_id"},
        "required_cut_actor_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "required_preserve_actor_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_event_sha256": {"$ref": "#/$defs/digest"},
        "event_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probe_id", "event_id", "node_id", "attempted_at_ms", "actor_id", "resource_id", "action"],
      "properties": {
        "probe_id": {"$ref": "#/$defs/id"},
        "event_id": {"$ref": "#/$defs/id"},
        "node_id": {"$ref": "#/$defs/id"},
        "attempted_at_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
        "actor_id": {"$ref": "#/$defs/id"},
        "resource_id": {"$ref": "#/$defs/id"},
        "action": {"enum": ["administer", "credential_use", "invoke", "read", "write"]}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_convergence_ms", "maximum_deadline_miss_count", "maximum_post_deadline_stale_allow_count", "maximum_collateral_block_count", "minimum_delivery_coverage_rate", "minimum_cut_recall", "minimum_pre_event_allow_rate", "minimum_preserved_allow_rate", "minimum_signal_disposition_accuracy"],
      "properties": {
        "maximum_convergence_ms": {"type": "integer", "minimum": 1, "maximum": 600000},
        "maximum_deadline_miss_count": {"$ref": "#/$defs/count"},
        "maximum_post_deadline_stale_allow_count": {"$ref": "#/$defs/count"},
        "maximum_collateral_block_count": {"$ref": "#/$defs/count"},
        "minimum_delivery_coverage_rate": {"$ref": "#/$defs/rate"},
        "minimum_cut_recall": {"$ref": "#/$defs/rate"},
        "minimum_pre_event_allow_rate": {"$ref": "#/$defs/rate"},
        "minimum_preserved_allow_rate": {"$ref": "#/$defs/rate"},
        "minimum_signal_disposition_accuracy": {"$ref": "#/$defs/rate"}
      }
    }
  }
}
