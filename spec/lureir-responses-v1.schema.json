{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lureir-responses/v1",
  "title": "LureIR structured responder submission v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "suite_id", "suite_version", "responses"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lureir-responses/v1"}, "schema_version": {"const": 1}, "suite_id": {"const": "lureir-defanged-v1"}, "suite_version": {"const": "1.0.0"},
    "responses": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["case_id", "timeline_event_ids", "findings", "evidence_requests", "containment_actions", "escalation"], "properties": {
        "case_id": {"$ref": "#/$defs/id"}, "timeline_event_ids": {"$ref": "#/$defs/id_array"}, "evidence_requests": {"$ref": "#/$defs/id_array"}, "containment_actions": {"$ref": "#/$defs/id_array"}, "escalation": {"enum": ["none", "security", "critical"]},
        "findings": {"type": "array", "maxItems": 32, "items": {"type": "object", "additionalProperties": false, "required": ["claim_code", "evidence_ids", "confidence"], "properties": {"claim_code": {"$ref": "#/$defs/id"}, "evidence_ids": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "confidence": {"enum": ["confirmed", "probable", "possible"]}}}}
      }
    }}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"}, "id_array": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}
}
