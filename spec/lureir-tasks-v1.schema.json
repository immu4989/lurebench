{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lureir-tasks/v1",
  "title": "LureIR defanged responder tasks v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "created_at", "suite_id", "suite_version", "cases", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lureir-tasks/v1"}, "schema_version": {"const": 1}, "created_at": {"type": "string", "format": "date-time"}, "suite_id": {"const": "lureir-defanged-v1"}, "suite_version": {"const": "1.0.0"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 64, "items": {
      "type": "object", "additionalProperties": false, "required": ["case_id", "title", "events", "response_contract"], "properties": {
        "case_id": {"$ref": "#/$defs/id"}, "title": {"type": "string", "minLength": 8, "maxLength": 160},
        "events": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "additionalProperties": false, "required": ["event_id", "sequence", "event_type", "signal_code", "outcome"], "properties": {"event_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 128}, "event_type": {"$ref": "#/$defs/id"}, "signal_code": {"$ref": "#/$defs/id"}, "outcome": {"$ref": "#/$defs/id"}}}},
        "response_contract": {"type": "object", "additionalProperties": false, "required": ["findings_use_claim_codes", "evidence_must_reference_event_ids", "containment_actions_are_non_executable_codes"], "properties": {"findings_use_claim_codes": {"const": true}, "evidence_must_reference_event_ids": {"const": true}, "containment_actions_are_non_executable_codes": {"const": true}}}
      }
    }},
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"}, "limitations": {"const": ["synthetic_defanged_metadata_only_no_commands_payloads_credentials_hosts_urls_or_reasoning", "response_quality_on_this_suite_does_not_establish_operational_incident_readiness", "containment_actions_are_codes_for_evaluation_and_are_never_executed", "human_review_and_organization_specific_authority_remain_required"]}}
}
