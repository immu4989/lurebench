{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/core-v2-build/v1",
  "title": "LureBench core v2 reproducible build manifest",
  "type": "object",
  "required": [
    "schema", "schema_version", "builder", "parameters", "review_gate",
    "deduplication", "clustering", "sources", "splits", "boundary_audit", "constraints"
  ],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/core-v2-build/v1"},
    "schema_version": {"const": 1},
    "builder": {"const": "lurebench-core-v2"},
    "parameters": {
      "type": "object",
      "required": ["weights", "near_duplicate_threshold", "word_shingle_size", "assignment"],
      "properties": {
        "weights": {
          "type": "object",
          "required": ["train", "validation", "test", "heldout"],
          "properties": {
            "train": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "validation": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "test": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "heldout": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
          },
          "additionalProperties": false
        },
        "near_duplicate_threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "word_shingle_size": {"type": "integer", "minimum": 1, "maximum": 20},
        "assignment": {"const": "deterministic_cluster_stratification_v1"}
      },
      "additionalProperties": false
    },
    "review_gate": {
      "type": "object",
      "required": ["loaded", "kept_before_exact_dedup", "dropped_pending", "dropped_flagged"],
      "properties": {
        "loaded": {"type": "integer", "minimum": 1},
        "kept_before_exact_dedup": {"type": "integer", "minimum": 1},
        "dropped_pending": {"type": "integer", "minimum": 0},
        "dropped_flagged": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "deduplication": {
      "type": "object",
      "required": ["normalized_exact_duplicates_removed", "records_after_exact_dedup"],
      "properties": {
        "normalized_exact_duplicates_removed": {"type": "integer", "minimum": 0},
        "records_after_exact_dedup": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "clustering": {
      "type": "object",
      "required": [
        "clusters", "largest_cluster", "explicit_family_unions",
        "near_duplicate_unions", "candidate_pairs_compared"
      ],
      "properties": {
        "clusters": {"type": "integer", "minimum": 4},
        "largest_cluster": {"type": "integer", "minimum": 1},
        "explicit_family_unions": {"type": "integer", "minimum": 0},
        "near_duplicate_unions": {"type": "integer", "minimum": 0},
        "candidate_pairs_compared": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "sha256", "loaded_records", "kept_records"],
        "properties": {
          "source": {"type": "string", "pattern": "^source-[0-9]{4}$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "loaded_records": {"type": "integer", "minimum": 0},
          "kept_records": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "splits": {
      "type": "object",
      "required": ["train", "validation", "test", "heldout"],
      "properties": {
        "train": {"$ref": "#/$defs/split"},
        "validation": {"$ref": "#/$defs/split"},
        "test": {"$ref": "#/$defs/split"},
        "heldout": {"$ref": "#/$defs/privateSplit"}
      },
      "additionalProperties": false
    },
    "boundary_audit": {
      "type": "object",
      "required": [
        "threshold", "shingle_size", "split_sizes", "family_overlaps",
        "near_duplicates", "passed"
      ],
      "properties": {
        "threshold": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "shingle_size": {"type": "integer", "minimum": 1, "maximum": 20},
        "split_sizes": {
          "type": "object",
          "required": ["train", "validation", "test", "heldout"],
          "properties": {
            "train": {"type": "integer", "minimum": 1},
            "validation": {"type": "integer", "minimum": 1},
            "test": {"type": "integer", "minimum": 1},
            "heldout": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "family_overlaps": {"type": "array", "maxItems": 0},
        "near_duplicates": {"type": "array", "maxItems": 0},
        "passed": {"const": true}
      },
      "additionalProperties": false
    },
    "constraints": {
      "const": [
        "heldout_records_and_labels_must_not_be_published",
        "test_must_not_be_used_for_model_or_threshold_selection",
        "source_commitments_identify_bytes_not_redistribution_rights"
      ]
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "required": ["records", "label", "source", "typology", "language", "channel"],
      "properties": {
        "records": {"type": "integer", "minimum": 1},
        "label": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "source": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "typology": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "language": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "channel": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      },
      "additionalProperties": false
    },
    "split": {
      "type": "object",
      "required": ["sha256", "profile", "publication"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile": {"$ref": "#/$defs/profile"},
        "publication": {"const": "public"}
      },
      "additionalProperties": false
    },
    "privateSplit": {
      "type": "object",
      "required": ["sha256", "profile", "publication"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "profile": {"$ref": "#/$defs/profile"},
        "publication": {"const": "private_evaluator_only"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
