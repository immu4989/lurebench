{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/comparison-panel-plan/v1",
  "title": "Declared cached detector comparison panel",
  "description": "Shape only. Runtime checks also enforce unique detector IDs, strict JSON, complete cache coverage, and statistical assumptions remain external.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task", "pairing_unit", "baseline", "candidates"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "task": {"enum": ["fraud", "provenance"]},
    "pairing_unit": {"enum": ["lineage", "record"]},
    "baseline": {"$ref": "#/$defs/detector"},
    "candidates": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/detector"}}
  },
  "$defs": {
    "cleanString": {"type": "string", "minLength": 1, "not": {"pattern": "[\u0000-\u001f\u007f\ud800-\udfff]"}},
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "cache", "threshold"],
      "properties": {
        "id": {"$ref": "#/$defs/cleanString", "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "name": {"$ref": "#/$defs/cleanString", "maxLength": 256},
        "cache": {"$ref": "#/$defs/cleanString", "maxLength": 4096},
        "threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "namespace": {"type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
