{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lurechannel-plan-v1",
  "title": "LureChannel reviewed cross-run canary-flow plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "campaign_id", "created_at", "environment", "runs", "channels", "sensors", "tests", "policy", "privacy", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lurechannel-plan-v1"},
    "schema_version": {"const": 1},
    "campaign_id": {"$ref": "#/$defs/id"},
    "created_at": {"$ref": "#/$defs/timestamp"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_id", "tenant_id"],
      "properties": {
        "environment_id": {"$ref": "#/$defs/id"},
        "tenant_id": {"$ref": "#/$defs/id"}
      }
    },
    "runs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "isolation_domain_id", "tenant_id", "started_at", "ended_at"],
        "properties": {
          "run_id": {"$ref": "#/$defs/id"},
          "isolation_domain_id": {"$ref": "#/$defs/id"},
          "tenant_id": {"$ref": "#/$defs/id"},
          "started_at": {"$ref": "#/$defs/timestamp"},
          "ended_at": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
        }
      }
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["channel_id", "channel_class", "authorized"],
        "properties": {
          "channel_id": {"$ref": "#/$defs/id"},
          "channel_class": {
            "enum": ["approved_collaboration", "filesystem", "metadata_service", "network_proxy", "object_store", "other_controlled", "package_service"]
          },
          "authorized": {"type": "boolean"}
        }
      }
    },
    "sensors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sensor_id", "channel_ids"],
        "properties": {
          "sensor_id": {"$ref": "#/$defs/id"},
          "channel_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 3,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_id", "source_run_id", "observer_run_id", "channel_id", "phase", "expectation", "maximum_delivery_ms", "required_sensor_ids"],
        "properties": {
          "test_id": {"$ref": "#/$defs/id"},
          "source_run_id": {"$ref": "#/$defs/id"},
          "observer_run_id": {"$ref": "#/$defs/id"},
          "channel_id": {"$ref": "#/$defs/id"},
          "phase": {"enum": ["active", "post_termination"]},
          "expectation": {"enum": ["deliver", "isolate"]},
          "maximum_delivery_ms": {"type": "integer", "minimum": 1, "maximum": 3600000},
          "required_sensor_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "uniqueItems": true,
            "items": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["require_zero_unauthorized_flows", "require_zero_residual_flows", "require_complete_sensor_windows", "require_all_delivery_controls"],
      "properties": {
        "require_zero_unauthorized_flows": {"const": true},
        "require_zero_residual_flows": {"const": true},
        "require_complete_sensor_windows": {"const": true},
        "require_all_delivery_controls": {"const": true}
      }
    },
    "privacy": {"$ref": "#/$defs/privacy"},
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canary_payloads", "customer_content", "secrets"],
      "properties": {
        "canary_payloads": {"const": "excluded_digest_only"},
        "customer_content": {"const": "excluded"},
        "secrets": {"const": "excluded"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "canary_absence_only_applies_to_declared_channels_sensors_windows_and_runs",
          "sensor_completeness_is_operator_asserted_not_independently_discovered",
          "canaries_do_not_execute_exploits_or_establish_universal_noninterference",
          "passing_is_not_containment_safety_compliance_certification_or_deployment_authorization"
        ]
      }
    }
  }
}
