{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/agent-coverage-evaluation/v1",
  "title": "LureCoverage evaluation report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "generated_at", "manifest", "canaries_sha256", "acceptance", "results", "summary", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/agent-coverage-evaluation/v1"},
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest_id", "manifest_version", "manifest_sha256"],
      "properties": {
        "manifest_id": {"$ref": "#/$defs/id"},
        "manifest_version": {"$ref": "#/$defs/id"},
        "manifest_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "canaries_sha256": {"$ref": "#/$defs/digest"},
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "results": {
      "type": "array", "minItems": 1, "maxItems": 4096,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["probe_id", "route_id", "required", "emitted_sequence", "observed_sequence", "delivered", "copies", "out_of_order", "lineage_contiguous", "delivery_delay_ms", "allowed_delivery_delay_ms", "passed"],
        "properties": {
          "probe_id": {"$ref": "#/$defs/id"},
          "route_id": {"$ref": "#/$defs/id"},
          "required": {"type": "boolean"},
          "emitted_sequence": {"type": "integer", "minimum": 1, "maximum": 131072},
          "observed_sequence": {"type": ["integer", "null"], "minimum": 1, "maximum": 131072},
          "delivered": {"type": "boolean"},
          "copies": {"type": "integer", "minimum": 0, "maximum": 1024},
          "out_of_order": {"type": "boolean"},
          "lineage_contiguous": {"type": "boolean"},
          "delivery_delay_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000},
          "allowed_delivery_delay_ms": {"type": "integer", "minimum": 1, "maximum": 86400000},
          "passed": {"type": "boolean"}
        }
      }
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["total_routes", "required_routes", "covered_required_routes", "total_probes", "delivered_probes", "missing_probes", "duplicate_probes", "out_of_order_probes", "lineage_contiguous_probes", "route_coverage", "probe_delivery_rate", "duplicate_rate", "out_of_order_rate", "lineage_continuity", "maximum_delivery_delay_ms", "verdict"],
      "properties": {
        "total_routes": {"type": "integer", "minimum": 1, "maximum": 256},
        "required_routes": {"type": "integer", "minimum": 1, "maximum": 256},
        "covered_required_routes": {"type": "integer", "minimum": 0, "maximum": 256},
        "total_probes": {"type": "integer", "minimum": 1, "maximum": 4096},
        "delivered_probes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "missing_probes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "duplicate_probes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "out_of_order_probes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "lineage_contiguous_probes": {"type": "integer", "minimum": 0, "maximum": 4096},
        "route_coverage": {"$ref": "#/$defs/rate"},
        "probe_delivery_rate": {"$ref": "#/$defs/rate"},
        "duplicate_rate": {"$ref": "#/$defs/rate"},
        "out_of_order_rate": {"$ref": "#/$defs/rate"},
        "lineage_continuity": {"$ref": "#/$defs/rate"},
        "maximum_delivery_delay_ms": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400000},
        "verdict": {"enum": ["pass", "fail"]}
      }
    },
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "acceptance": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_route_coverage", "minimum_probe_delivery_rate", "maximum_duplicate_rate", "maximum_out_of_order_rate", "minimum_lineage_continuity", "maximum_delivery_delay_ms"],
      "properties": {
        "minimum_route_coverage": {"$ref": "#/$defs/rate"},
        "minimum_probe_delivery_rate": {"$ref": "#/$defs/rate"},
        "maximum_duplicate_rate": {"$ref": "#/$defs/rate"},
        "maximum_out_of_order_rate": {"$ref": "#/$defs/rate"},
        "minimum_lineage_continuity": {"$ref": "#/$defs/rate"},
        "maximum_delivery_delay_ms": {"type": "integer", "minimum": 1, "maximum": 86400000}
      }
    },
    "limitations": {"const": ["canaries_are_typed_metadata_and_do_not_execute_agent_actions", "coverage_applies_only_to_declared_routes_sensors_and_capture_window", "sensor_acknowledgements_are_operator_supplied_and_must_be_independently_trusted", "passing_does_not_prove_semantic_correctness_of_non_canary_production_events", "results_are_measurement_evidence_not_containment_compliance_or_authorization"]}
  }
}
