{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/luremandate-conformance-challenge/v1",
  "title": "LureMandate answer-free conformance challenge v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "challenge_id",
    "generated_at",
    "campaign_id",
    "plan_sha256",
    "plan",
    "execution",
    "cases",
    "privacy",
    "limitations"
  ],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/luremandate-conformance-challenge/v1"},
    "schema_version": {"const": 1},
    "challenge_id": {"$ref": "#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
    "campaign_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "plan": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-plan-v1"},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "started_at", "completed_at", "state_model"],
      "properties": {
        "run_id": {"$ref": "#/$defs/id"},
        "started_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
        "completed_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"},
        "state_model": {"const": "single_session_ordered_no_reset"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "sequence", "transaction"],
        "properties": {
          "case_id": {"type": "string", "pattern": "^case-[0-9]{4}$"},
          "sequence": {"type": "integer", "minimum": 1, "maximum": 4096},
          "transaction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["transaction_id", "intent", "intent_sha256", "approvals", "decided_at"],
            "properties": {
              "transaction_id": {"$ref": "#/$defs/id"},
              "intent": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-run-v1#/$defs/intent"},
              "intent_sha256": {"$ref": "#/$defs/digest"},
              "approvals": {
                "type": "array",
                "maxItems": 16,
                "items": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-run-v1#/$defs/approval"}
              },
              "decided_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:[.][0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"}
            }
          }
        }
      }
    },
    "privacy": {
      "const": {
        "transaction_payloads": "excluded_digest_bound_metadata_only",
        "customer_content": "excluded",
        "personal_data": "synthetic_identifiers_only",
        "secrets": "excluded"
      }
    },
    "limitations": {"$ref": "#/$defs/limitations"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "limitations": {
      "const": [
        "challenge_omits_expected_decisions_and_reasons_but_does_not_prevent_input_inference",
        "cases_measure_only_declared_metadata_and_stateful_order_not_unrepresented_actions",
        "reference_submission_tests_the_reference_semantics_not_an_external_gateway",
        "engine_identity_and_submitted_results_are_claims_unless_authenticated_externally",
        "passing_is_not_complete_mediation_safety_compliance_or_deployment_authorization"
      ]
    }
  }
}
