{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lureir-evaluation/v1",
  "title": "LureIR readiness evaluation report v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "generated_at", "suite", "responder", "acceptance", "results", "summary", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lureir-evaluation/v1"}, "schema_version": {"const": 1}, "generated_at": {"type": "string", "format": "date-time"},
    "suite": {"type": "object", "additionalProperties": false, "required": ["suite_id", "suite_version", "suite_sha256"], "properties": {"suite_id": {"const": "lureir-defanged-v1"}, "suite_version": {"const": "1.0.0"}, "suite_sha256": {"$ref": "#/$defs/digest"}}},
    "responder": {"type": "object", "additionalProperties": false, "required": ["responder_id", "responder_version", "response_sha256"], "properties": {"responder_id": {"$ref": "#/$defs/id"}, "responder_version": {"type": "string", "minLength": 1, "maxLength": 64}, "response_sha256": {"$ref": "#/$defs/digest"}}},
    "acceptance": {"type": "object", "additionalProperties": false, "required": ["minimum_fact_recall", "minimum_fact_precision", "minimum_evidence_support_rate", "minimum_timeline_accuracy", "minimum_evidence_request_recall", "minimum_containment_action_recall", "maximum_unsafe_action_rate", "minimum_escalation_accuracy"], "properties": {"minimum_fact_recall": {"$ref": "#/$defs/rate"}, "minimum_fact_precision": {"$ref": "#/$defs/rate"}, "minimum_evidence_support_rate": {"$ref": "#/$defs/rate"}, "minimum_timeline_accuracy": {"$ref": "#/$defs/rate"}, "minimum_evidence_request_recall": {"$ref": "#/$defs/rate"}, "minimum_containment_action_recall": {"$ref": "#/$defs/rate"}, "maximum_unsafe_action_rate": {"$ref": "#/$defs/rate"}, "minimum_escalation_accuracy": {"$ref": "#/$defs/rate"}}},
    "results": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["case_id", "expected_facts", "claimed_facts", "correct_facts", "supported_correct_facts", "timeline_correct", "required_evidence_requests", "satisfied_evidence_requests", "required_containment_actions", "satisfied_containment_actions", "containment_actions", "unsafe_actions", "escalation_correct"], "properties": {"case_id": {"$ref": "#/$defs/id"}, "expected_facts": {"$ref": "#/$defs/count"}, "claimed_facts": {"$ref": "#/$defs/count"}, "correct_facts": {"$ref": "#/$defs/count"}, "supported_correct_facts": {"$ref": "#/$defs/count"}, "timeline_correct": {"type": "boolean"}, "required_evidence_requests": {"$ref": "#/$defs/count"}, "satisfied_evidence_requests": {"$ref": "#/$defs/count"}, "required_containment_actions": {"$ref": "#/$defs/count"}, "satisfied_containment_actions": {"$ref": "#/$defs/count"}, "containment_actions": {"$ref": "#/$defs/count"}, "unsafe_actions": {"$ref": "#/$defs/count"}, "escalation_correct": {"type": "boolean"}}}},
    "summary": {"type": "object", "additionalProperties": false, "required": ["case_count", "fact_recall", "fact_precision", "evidence_support_rate", "timeline_accuracy", "evidence_request_recall", "containment_action_recall", "unsafe_action_rate", "escalation_accuracy", "verdict"], "properties": {"case_count": {"type": "integer", "minimum": 1, "maximum": 64}, "fact_recall": {"$ref": "#/$defs/rate"}, "fact_precision": {"$ref": "#/$defs/rate"}, "evidence_support_rate": {"$ref": "#/$defs/rate"}, "timeline_accuracy": {"$ref": "#/$defs/rate"}, "evidence_request_recall": {"$ref": "#/$defs/rate"}, "containment_action_recall": {"$ref": "#/$defs/rate"}, "unsafe_action_rate": {"$ref": "#/$defs/rate"}, "escalation_accuracy": {"$ref": "#/$defs/rate"}, "verdict": {"enum": ["pass", "fail"]}}},
    "limitations": {"const": ["synthetic_defanged_metadata_only_no_commands_payloads_credentials_hosts_urls_or_reasoning", "response_quality_on_this_suite_does_not_establish_operational_incident_readiness", "containment_actions_are_codes_for_evaluation_and_are_never_executed", "human_review_and_organization_specific_authority_remain_required"]}
  },
  "$defs": {"id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"}, "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "rate": {"type": "number", "minimum": 0, "maximum": 1}, "count": {"type": "integer", "minimum": 0, "maximum": 4096}}
}
