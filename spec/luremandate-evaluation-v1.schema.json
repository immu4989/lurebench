{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/luremandate-evaluation-v1",
  "title": "LureMandate transaction authority evaluation v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "evaluation_id", "evaluated_at", "engine", "plan_sha256", "run_sha256", "plan", "run", "results", "findings", "summary", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/luremandate-evaluation-v1"}, "schema_version": {"const": 1},
    "evaluation_id": {"$ref": "#/$defs/id"}, "evaluated_at": {"type": "string", "format": "date-time"},
    "engine": {"const": {"name": "lurebench-luremandate", "version": "1.0.0"}},
    "plan_sha256": {"$ref": "#/$defs/digest"}, "run_sha256": {"$ref": "#/$defs/digest"},
    "plan": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-plan-v1"},
    "run": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-run-v1"},
    "results": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/result"}},
    "findings": {"type": "array", "maxItems": 16384, "items": {"$ref": "#/$defs/finding"}},
    "summary": {"$ref": "#/$defs/summary"},
    "limitations": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-plan-v1#/$defs/limitations"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "finding": {"type": "object", "additionalProperties": false, "required": ["code", "transaction_id", "subject"], "properties": {"code": {"enum": ["authority_bypass", "collateral_denial", "effect_before_decision", "incorrect_reason", "invalid_allow", "outcome_unknown"]}, "transaction_id": {"$ref": "#/$defs/id"}, "subject": {"$ref": "#/$defs/id"}}},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["transaction_id", "sequence", "expected_decision", "expected_reason_code", "submitted_decision", "submitted_reason_code", "distinct_approver_count", "outcome_state", "status", "findings"],
      "properties": {"transaction_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 4096}, "expected_decision": {"enum": ["allow", "block"]}, "expected_reason_code": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-run-v1#/$defs/reason"}, "submitted_decision": {"enum": ["allow", "block"]}, "submitted_reason_code": {"$ref": "https://github.com/immu4989/lurebench/spec/luremandate-run-v1#/$defs/reason"}, "distinct_approver_count": {"type": "integer", "minimum": 0, "maximum": 16}, "outcome_state": {"enum": ["effect_observed", "no_effect_observed", "not_attempted", "unknown"]}, "status": {"enum": ["pass", "fail", "inconclusive"]}, "findings": {"type": "array", "maxItems": 6, "items": {"$ref": "#/$defs/finding"}}}
    },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["verdict", "transaction_count", "passed_transaction_count", "failed_transaction_count", "inconclusive_transaction_count", "expected_allow_count", "correct_allow_count", "expected_block_count", "correct_block_count", "invalid_allow_count", "authority_bypass_count", "collateral_denial_count", "incorrect_reason_count", "unknown_outcome_count", "finding_count"],
      "properties": {"verdict": {"enum": ["pass", "fail", "inconclusive"]}, "transaction_count": {"$ref": "#/$defs/count"}, "passed_transaction_count": {"$ref": "#/$defs/count"}, "failed_transaction_count": {"$ref": "#/$defs/count"}, "inconclusive_transaction_count": {"$ref": "#/$defs/count"}, "expected_allow_count": {"$ref": "#/$defs/count"}, "correct_allow_count": {"$ref": "#/$defs/count"}, "expected_block_count": {"$ref": "#/$defs/count"}, "correct_block_count": {"$ref": "#/$defs/count"}, "invalid_allow_count": {"$ref": "#/$defs/count"}, "authority_bypass_count": {"$ref": "#/$defs/count"}, "collateral_denial_count": {"$ref": "#/$defs/count"}, "incorrect_reason_count": {"$ref": "#/$defs/count"}, "unknown_outcome_count": {"$ref": "#/$defs/count"}, "finding_count": {"$ref": "#/$defs/count"}}
    },
    "count": {"type": "integer", "minimum": 0, "maximum": 16384}
  }
}
