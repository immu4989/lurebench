{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lureidentity-evaluation-v1",
  "title": "LureIdentity lifecycle-closure evaluation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "generated_at", "implementation", "plan", "plan_sha256", "run", "run_sha256", "summary", "event_results", "delivery_results", "probe_results", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lureidentity-evaluation-v1"},
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "implementation": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"const": "lurebench"}, "version": {"$ref": "#/$defs/id"}}},
    "plan": {"$ref": "https://github.com/immu4989/lurebench/spec/lureidentity-plan-v1"},
    "plan_sha256": {"$ref": "#/$defs/digest"},
    "run": {"$ref": "https://github.com/immu4989/lurebench/spec/lureidentity-run-v1"},
    "run_sha256": {"$ref": "#/$defs/digest"},
    "summary": {"$ref": "#/$defs/summary"},
    "event_results": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/event_result"}},
    "delivery_results": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/delivery_result"}},
    "probe_results": {"type": "array", "minItems": 1, "maxItems": 8192, "items": {"$ref": "#/$defs/probe_result"}},
    "limitations": {"const": ["authority_closure_and_metrics_are_recomputed_from_embedded_plan_and_run_metadata", "a_graph_cut_covers_only_preregistered_principals_edges_grants_nodes_and_probes", "passing_does_not_establish_identity_proofing_event_authenticity_or_complete_mediation", "evaluation_is_not_certification_authorization_or_a_claim_of_scim_interoperability"]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "rate": {"type": "number", "minimum": 0, "maximum": 1},
    "count": {"type": "integer", "minimum": 0, "maximum": 100000},
    "nullable_ms": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 86400000}, {"type": "null"}]},
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "resource_id", "action"],
      "properties": {"actor_id": {"$ref": "#/$defs/id"}, "resource_id": {"$ref": "#/$defs/id"}, "action": {"enum": ["administer", "credential_use", "invoke", "read", "write"]}}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_count", "authority_edge_count", "grant_count", "event_count", "node_count", "affected_authorization_count", "required_delivery_count", "applied_delivery_count", "delivery_coverage_rate", "maximum_convergence_ms", "p95_convergence_ms", "deadline_miss_count", "post_deadline_stale_allow_count", "collateral_block_count", "cut_recall", "pre_event_allow_rate", "preserved_allow_rate", "signal_disposition_accuracy", "incorrect_decision_count", "incorrect_reason_count", "verdict"],
      "properties": {
        "principal_count": {"$ref": "#/$defs/count"}, "authority_edge_count": {"$ref": "#/$defs/count"}, "grant_count": {"$ref": "#/$defs/count"}, "event_count": {"$ref": "#/$defs/count"}, "node_count": {"$ref": "#/$defs/count"}, "affected_authorization_count": {"$ref": "#/$defs/count"}, "required_delivery_count": {"$ref": "#/$defs/count"}, "applied_delivery_count": {"$ref": "#/$defs/count"}, "delivery_coverage_rate": {"$ref": "#/$defs/rate"}, "maximum_convergence_ms": {"$ref": "#/$defs/nullable_ms"}, "p95_convergence_ms": {"$ref": "#/$defs/nullable_ms"}, "deadline_miss_count": {"$ref": "#/$defs/count"}, "post_deadline_stale_allow_count": {"$ref": "#/$defs/count"}, "collateral_block_count": {"$ref": "#/$defs/count"}, "cut_recall": {"$ref": "#/$defs/rate"}, "pre_event_allow_rate": {"$ref": "#/$defs/rate"}, "preserved_allow_rate": {"$ref": "#/$defs/rate"}, "signal_disposition_accuracy": {"$ref": "#/$defs/rate"}, "incorrect_decision_count": {"$ref": "#/$defs/count"}, "incorrect_reason_count": {"$ref": "#/$defs/count"}, "verdict": {"enum": ["pass", "fail"]}
      }
    },
    "event_result": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "event_type", "affected_authorization_count", "affected_authorizations"],
      "properties": {"event_id": {"$ref": "#/$defs/id"}, "event_type": {"enum": ["delegation_revoked", "scim_group_membership_removed", "scim_user_deactivated", "workload_retired"]}, "affected_authorization_count": {"$ref": "#/$defs/count"}, "affected_authorizations": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/authorization"}}}
    },
    "delivery_result": {
      "type": "object", "additionalProperties": false,
      "required": ["event_id", "node_id", "applied_at_ms", "convergence_ms", "deadline_met"],
      "properties": {"event_id": {"$ref": "#/$defs/id"}, "node_id": {"$ref": "#/$defs/id"}, "applied_at_ms": {"$ref": "#/$defs/nullable_ms"}, "convergence_ms": {"$ref": "#/$defs/nullable_ms"}, "deadline_met": {"type": "boolean"}}
    },
    "probe_result": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "event_id", "node_id", "actor_id", "resource_id", "action", "phase", "expected_decision", "submitted_decision", "expected_reason_code", "submitted_reason_code", "classification"],
      "properties": {
        "probe_id": {"$ref": "#/$defs/id"}, "event_id": {"$ref": "#/$defs/id"}, "node_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "resource_id": {"$ref": "#/$defs/id"}, "action": {"enum": ["administer", "credential_use", "invoke", "read", "write"]}, "phase": {"enum": ["pre_event", "propagation_window", "cut_effective", "post_deadline", "unrelated_control"]}, "expected_decision": {"enum": ["allow", "block"]}, "submitted_decision": {"enum": ["allow", "block"]}, "expected_reason_code": {"enum": ["authority_active", "authority_path_cut", "authority_preserved", "lifecycle_event_pending"]}, "submitted_reason_code": {"enum": ["authority_active", "authority_path_cut", "authority_preserved", "lifecycle_event_pending"]}, "classification": {"enum": ["correct", "stale_authorization", "collateral_denial", "premature_denial", "wrong_reason"]}
      }
    }
  }
}
