{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/immu4989/lurebench/spec/lureattest-plan-v1",
  "title": "LureAttest compiled provenance-authentication plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "plan_id", "created_at", "artifact_plan", "trust_policy", "trusted_builders", "workloads", "requirements", "limitations"],
  "properties": {
    "schema": {"const": "https://github.com/immu4989/lurebench/spec/lureattest-plan-v1"},
    "schema_version": {"const": 1},
    "plan_id": {"$ref": "#/$defs/id"},
    "created_at": {"type": "string", "format": "date-time"},
    "artifact_plan": {"$ref": "#/$defs/artifactRef"},
    "trust_policy": {"$ref": "#/$defs/policyRef"},
    "trusted_builders": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "https://github.com/immu4989/lurebench/spec/lureattest-trust-policy-v1#/$defs/builder"}},
    "workloads": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/workload"}},
    "requirements": {"$ref": "https://github.com/immu4989/lurebench/spec/lureattest-trust-policy-v1#/$defs/requirements"},
    "limitations": {"const": [
      "plan_binds_every_lureartifact_provenance_claim_to_one_reviewed_signer_and_expectation",
      "plan_compilation_does_not_authenticate_signatures_or_certify_build_platforms",
      "source_matching_requires_one_exact_uri_and_sha256_resolved_dependency",
      "actual_artifact_bytes_ai_bom_documents_and_build_execution_are_not_inspected",
      "a_matching_plan_is_not_artifact_safety_quality_licensing_compliance_or_authorization"
    ]}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?$"},
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "uri": {"type": "string", "minLength": 1, "maxLength": 2048, "pattern": "^(https://|urn:)[^\\s#]+$"},
    "artifactRef": {"type": "object", "additionalProperties": false, "required": ["plan_id", "sha256"], "properties": {"plan_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "policyRef": {"type": "object", "additionalProperties": false, "required": ["policy_id", "sha256"], "properties": {"policy_id": {"$ref": "#/$defs/id"}, "sha256": {"$ref": "#/$defs/digest"}}},
    "workload": {
      "type": "object", "additionalProperties": false,
      "required": ["workload_principal_id", "attestations"],
      "properties": {
        "workload_principal_id": {"$ref": "#/$defs/id"},
        "attestations": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "#/$defs/attestation"}}
      }
    },
    "attestation": {
      "type": "object", "additionalProperties": false,
      "required": ["attestation_id", "evidence_file", "subject_artifact_id", "subject_sha256", "statement_sha256", "statement_type", "predicate_type", "builder_id", "build_type", "source_uri", "source_sha256", "external_parameters_sha256", "public_key_sha256", "minimum_slsa_build_level"],
      "properties": {
        "attestation_id": {"$ref": "#/$defs/id"},
        "evidence_file": {"type": "string", "minLength": 11, "maxLength": 106, "pattern": "^[a-z0-9]+(?:[a-z0-9._-]*[a-z0-9])?\\.dsse\\.json$"},
        "subject_artifact_id": {"$ref": "#/$defs/id"},
        "subject_sha256": {"$ref": "#/$defs/digest"},
        "statement_sha256": {"$ref": "#/$defs/digest"},
        "statement_type": {"const": "https://in-toto.io/Statement/v1"},
        "predicate_type": {"const": "https://slsa.dev/provenance/v1"},
        "builder_id": {"$ref": "#/$defs/uri"},
        "build_type": {"$ref": "#/$defs/uri"},
        "source_uri": {"$ref": "#/$defs/uri"},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "external_parameters_sha256": {"$ref": "#/$defs/digest"},
        "public_key_sha256": {"$ref": "#/$defs/digest"},
        "minimum_slsa_build_level": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    }
  }
}
